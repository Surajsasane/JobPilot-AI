APP_NAME=JobPilot AI
ENVIRONMENT=development
API_PREFIX=/api/v1
# Easy local setup. For PostgreSQL use: postgresql+psycopg://USER:PASSWORD@localhost:5432/jobpilot
DATABASE_URL=sqlite:///./jobpilot.db
# Replace this with a long random secret before deployment.
SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
